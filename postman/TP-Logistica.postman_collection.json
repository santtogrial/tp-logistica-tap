              "raw": "{\n  \"depositoId\": 1,\n  \"destinatarioId\": 6,\n  \"items\": [\n    {\n      \"productoId\": 2,\n      \"cantidad\": 2\n    },\n    {\n      \"productoId\": 4,\n      \"cantidad\": 1\n    }\n  ]\n}"
