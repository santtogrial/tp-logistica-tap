                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set(\"ordenId\", o.id);",
                  "pm.collectionVariables.set(\"codigo\", o.codigoSeguimiento);",
                  "pm.test(\"Queda CREADA\", () => pm.expect(o.estado).to.eql(\"CREADA\"));"
                ]
