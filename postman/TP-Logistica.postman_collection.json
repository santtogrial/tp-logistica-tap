              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depositoId\": 1,\n  \"vehiculoIds\": [\n    1,\n    2\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const ruta = pm.response.json().rutas.find(r => r.vehiculoId === 1);",
                  "pm.collectionVariables.set(\"rutaId\", ruta.id);",
                  "ruta.paradas.forEach((p, i) => pm.collectionVariables.set(\"parada\" + (i + 1), p.id));",
                  "pm.collectionVariables.set(\"ordenEnRuta\", ruta.paradas[0].ordenId);",
                  "pm.collectionVariables.set(\"codigoEnRuta\", ruta.paradas[0].codigoSeguimiento);"
                ]
              }
            }
          ]
        }
